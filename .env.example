# ---------------------------------------------------------------------------
# Copy to .env and fill in. .env is gitignored - never commit real keys.
# ---------------------------------------------------------------------------

# Retell AI ------------------------------------------------------------------
RETELL_API_KEY=key_xxxxxxxxxxxxxxxxxxxxxxxx
RETELL_AGENT_ID=agent_xxxxxxxxxxxxxxxxxxxxxxxx
RETELL_LLM_ID=llm_xxxxxxxxxxxxxxxxxxxxxxxx

# n8n ------------------------------------------------------------------------
# Base URL of your n8n instance, no trailing slash.
# Cloud looks like https://yourname.app.n8n.cloud
# The agent calls {N8N_BASE_URL}/webhook/nsjapan-inventory-search and
#                {N8N_BASE_URL}/webhook/nsjapan-lead
N8N_BASE_URL=https://your-instance.app.n8n.cloud
N8N_API_KEY=

# GoHighLevel ----------------------------------------------------------------
# Private Integration Token (Settings > Private Integrations) and the sub-account
# location id. Pipeline settings are optional - leave blank to skip creating an
# opportunity and only create the contact plus a note.
GHL_TOKEN=
GHL_LOCATION_ID=
GHL_PIPELINE_ID=
GHL_PIPELINE_STAGE_ID=

# Where the agent reads live stock from (raw GitHub URL of data/inventory.json)
INVENTORY_URL=https://raw.githubusercontent.com/HamidIshfaq001/nsjapan-voice-agent/main/data/inventory.json

# Voice delivery ------------------------------------------------------------
# voice_model: eleven_v3 | eleven_flash_v2_5 | eleven_flash_v2 | eleven_multilingual_v2
VOICE_MODEL=eleven_v3
EXPRESSIVE_MODE=true
VOICE_SPEED=1.05
# Comma-separated. Allowed: empathetic, excited, happy, curious, surprised,
# sigh, clear throat, pause, long pause, emphasis. Blank = all ten.
# Drop "pause,long pause,clear throat,sigh" for a brisker, more businesslike call.
EXPRESSIVE_TAGS=
